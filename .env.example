# Local Docker: docker compose up --build -d
PORT=8000
# Set BOTH for public HTTPS deployment; leave blank locally.
PUBLIC_ORIGIN=
SITE_ADDRESS=localhost
MAX_UPLOAD_MB=200
MAX_PAGES=500
MAX_OUTPUT_MB=1024
RETENTION_HOURS=24
MAX_ACTIVE_JOBS=10
JOBS_PER_SESSION=3
JOBS_PER_IP_DAY=10
# AI tutor (stage 3) — optional and billed. Leave ANTHROPIC_API_KEY blank to keep the
# converter and course reader fully free/offline; the tutor panel then shows "offline".
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5
TUTOR_EFFORT=low
TUTOR_MAX_TOKENS=1024
