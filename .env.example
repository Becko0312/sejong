# Local Docker: docker compose up --build -d
PORT=8000
# Set BOTH for public HTTPS deployment; leave blank locally.
PUBLIC_ORIGIN=
SITE_ADDRESS=localhost
MAX_UPLOAD_MB=200
MAX_PAGES=500
MAX_OUTPUT_MB=1024
RETENTION_HOURS=24
MAX_ACTIVE_JOBS=10
JOBS_PER_SESSION=3
JOBS_PER_IP_DAY=10
# Admin account, seeded on startup (username/password login). Set a strong password
# before any real deployment; admins add courses, clients self-register as students.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# AI tutor (stage 3) — optional and billed. Copy this file to .env (gitignored) and put
# real keys there, never here. Leave the keys blank to keep the converter and course
# reader fully free/offline; the tutor panel then shows "offline".
# TUTOR_PROVIDER selects the model backend: "gemini" or "anthropic".
TUTOR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Live voice mode (hands-free tutor). Needs the Gemini provider with Live API access.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Aoede
LIVE_MAX_SECONDS=300
# Prepaid Live minutes: free minutes per new account, and "minutes:price_MNT" packages.
LIVE_FREE_MINUTES=10
LIVE_PACKAGES=30:5000,60:9000,120:16000
# PayLink (paylink.mn) — leave blank to disable online top-ups (admins can still grant minutes).
PAYLINK_USERNAME=
PAYLINK_PASSWORD=
PAYLINK_ENV=test
# How easily noise counts as the student interrupting (START_SENSITIVITY_LOW/HIGH; ms of speech required).
GEMINI_LIVE_START_SENSITIVITY=START_SENSITIVITY_LOW
GEMINI_LIVE_PREFIX_PADDING_MS=200
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5
TUTOR_EFFORT=low
TUTOR_MAX_TOKENS=1024

# Read-aloud speech (app/tts.py, POST /api/tts) — optional and billed (Azure Speech
# F0 free tier covers 500k neural characters/month). Set a Speech resource key and
# its region so the reader can speak Mongolian (mn-MN), which no browser voice has;
# leave blank to keep using the browser's own voices only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Override the Mongolian voice if you prefer another one (mn-MN-BataarNeural = male).
TTS_VOICE_MN=

# Daily Azure spend email (scripts/azure_credit_report.py, run from
# .github/workflows/azure-credit-report.yml). Configure secrets and
# variables in the GitHub repo; these entries document the same names
# for local dry-runs (REPORT_DRY_RUN=1 to print instead of send).
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
REPORT_EMAIL_TO=becko0312@gmail.com
REPORT_EMAIL_FROM=
REPORT_SMTP_HOST=smtp.gmail.com
REPORT_SMTP_PORT=587
REPORT_SMTP_USERNAME=
REPORT_SMTP_PASSWORD=
REPORT_BUDGET_AMOUNT=
REPORT_BUDGET_CURRENCY=
